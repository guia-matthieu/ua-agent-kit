{
  "name": "ua-agent-kit",
  "version": "0.1.0",
  "description": "Universal Acceptance test battery, guide and form checker for AI coding agents",
  "type": "module",
  "license": "MIT",
  "author": "Matthieu Crédou",
  "repository": {
    "type": "git",
    "url": "https://github.com/guia-matthieu/ua-agent-kit.git"
  },
  "homepage": "https://github.com/guia-matthieu/ua-agent-kit#readme",
  "bugs": {
    "url": "https://github.com/guia-matthieu/ua-agent-kit/issues"
  },
  "bin": {
    "ua-kit": "bin/ua-kit.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "runners",
    "battery",
    "patterns",
    "adapters",
    "GUIDE.md",
    "README.md",
    "LICENSE-CODE.md",
    "LICENSE-DATA.md",
    "LICENSE-GUIDE.md",
    "!**/__pycache__"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:py": "python3 -m unittest discover -s tests/py -p 'test_*.py'",
    "lint": "eslint .",
    "check:battery": "node scripts/check-battery.mjs",
    "build:adapters": "node scripts/build-adapters.mjs",
    "check:adapters": "node scripts/build-adapters.mjs --check"
  },
  "dependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "ajv": "^8.0.0",
    "eslint": "^9.0.0"
  }
}
