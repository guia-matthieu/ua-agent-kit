{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ua-agent-kit battery",
  "type": "object",
  "required": ["version", "generated", "license", "method", "cases"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "license": { "const": "CC0-1.0" },
    "method": { "type": "string" },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "class", "value", "expect", "note", "ref"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(email|domain|url)-[a-z0-9-]+-\\d{2}$" },
          "kind": { "enum": ["email", "domain", "url"] },
          "class": { "enum": ["control", "ascii-tld-short", "ascii-tld-long", "idn-tld-alabel", "idn-sld-alabel", "idn-ulabel", "eai-local", "email-idn-domain", "eai-full", "boundary", "guard"] },
          "value": { "type": "string", "minLength": 1 },
          "expect": { "enum": ["accept", "reject"] },
          "note": { "type": "string" },
          "ref": { "type": "string" }
        }
      }
    }
  }
}
